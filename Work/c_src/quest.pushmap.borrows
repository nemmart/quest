# M4b P20 borrow map — 23 WPSH/WPOP frame-borrow brackets.
# borrow <pc> <slot>: opcode decides — WPSH stores AC[r] to the slot
# (not the stack), WPOP loads it back (does not pop). Slots are the
# reserved block [74000000, 7400005C); frames start above it.
borrow 7015F7BA 74000000   # slot0 WPSH
borrow 7015F7BE 74000000   # slot0 WPOP
borrow 7015F7C5 74000004   # slot1 WPSH
borrow 7015F7C9 74000004   # slot1 WPOP
borrow 7015F7D0 74000008   # slot2 WPSH
borrow 7015F7D4 74000008   # slot2 WPOP
borrow 7015F7EE 7400000C   # slot3 WPSH
borrow 7015F7F2 7400000C   # slot3 WPOP
borrow 7015F7F9 74000010   # slot4 WPSH
borrow 7015F7FD 74000010   # slot4 WPOP
borrow 7015F80E 74000014   # slot5 WPSH
borrow 7015F812 74000014   # slot5 WPOP
borrow 7015F819 74000018   # slot6 WPSH
borrow 7015F81D 74000018   # slot6 WPOP
borrow 7015F82E 7400001C   # slot7 WPSH
borrow 7015F832 7400001C   # slot7 WPOP
borrow 7015F839 74000020   # slot8 WPSH
borrow 7015F83D 74000020   # slot8 WPOP
borrow 70165345 74000024   # slot9 WPSH
borrow 70165349 74000024   # slot9 WPOP
borrow 7016534D 74000028   # slot10 WPSH
borrow 70165351 74000028   # slot10 WPOP
borrow 70166369 7400002C   # slot11 WPSH
borrow 7016636D 7400002C   # slot11 WPOP
