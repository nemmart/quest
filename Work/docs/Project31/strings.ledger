7016D84D WCMV emitted -	[@bp(ac3, 100), 110] = [@0x7016CBEF:0, "\x0A\x14Protection\x15       -  The shimmering air lets everyone near\x0A                    you know that they are safe \x0A"]
7016D853 WCMV emitted -	[@ac2, 109] = [@0x7016CBB7:0, "                    within your field of protection. But\x0A                    they must stay in sight of you.\x0A"]
7016D85E WCMV emitted -	[@wp(ac3, 168), 219 varying] = [@bp(ac3, 100), 219]
7016D874 WCMV emitted -	[@wp(ac3, 50), 122 varying] = [@0x7016CB79:0, "\x0A\x14Eye of ARGUS\x15     -  For a brief time you can see the wonders\x0A                    of the world through the eye of ARGUS\x0A"]
7016D88A WCMV emitted -	[@wp(ac3, 50), 113 varying] = [@0x7016CB3F:0, "\x0A\x14Activate Caduceus\x15-  The staff of HERMES is used to heal all\x0A                    your injuries. Heal thyself. \x0A"]
7016D89E WCMV emitted -	[@bp(ac3, 100), 116] = [@0x7016CB05:0, "\x0A\x14Strength of ATLAS\x15-  New energy flows into you giving you \x0A                    extra strength. Alas,the effect is\x0A"]
7016D8A4 WCMV emitted -	[@ac2, 35] = [@0x7016CAF3:0, "                    not permanent.\x0A"]
7016D8AF WCMV emitted -	[@wp(ac3, 168), 151 varying] = [@bp(ac3, 100), 151]
7016D8C3 WCMV emitted -	[@bp(ac3, 100), 113] = [@0x7016CAB9:0, "\x0A\x14Wield death staff\x15-  Anyone next to you is about to die.\x0A                    Use this power wisely. GODs frown\x0A"]
7016D8C9 WCMV emitted -	[@ac2, 55] = [@0x7016CA9D:0, "                    upon indiscriminate Death Dealers.\x0A"]
