7016D6CF WCMV emitted -	[@wp(ac3, 50), 165 varying] = [@0x7016D043:0, "\x0C        Spells:\x0A\x0AOne of the attack options is to cast a spell at the target.\x0AThe following is a list of your available spells and\x0Atheir effect on the opposition.\x0A\x0A\x0A"]
7016D713 WCMV emitted -	[@wp(ac3, 50), 121 varying] = [@0x7016D005:0, "\x0A\x14Lightning bolt\x15 -    A lightning bolt will descend from the\x0A                    heavens, striking a blow to the enemy.\x0A"]
7016D729 WCMV emitted -	[@wp(ac3, 50), 168 varying] = [@0x7016CFB1:0, "\x0A\x14Magic shield\x15 -      This transparent shield absorbs the blows\x0A                    from attacking beings, but at a cost of\x0A                    shattering the shield.\x0A"]
7016D73F WCMV emitted -	[@wp(ac3, 50), 120 varying] = [@0x7016CF75:0, "\x0A\x14Farenheit foiler\x15 -  A heat ray \x22foils\x22 the enemy, causing a\x0A                    lighter hit than the lightning bolt.\x0A"]
7016D755 WCMV emitted -	[@wp(ac3, 50), 118 varying] = [@0x7016CF39:0, "\x0A\x14Smoke screen\x15     -  Smoke billows forth, confusing your enemy\x0A                    and allowing you one extra move.\x0A"]
7016D76B WCMV emitted -	[@wp(ac3, 50), 167 varying] = [@0x7016CEE5:0, "\x0A\x14Obtain knowledge\x15 -  A strange sensation overcomes you. You are\x0A                    now able to determine strengths or levels\x0A                    of certain things.\x0A"]
