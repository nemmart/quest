7016D58B WCMV emitted -	[@wp(ac3, 34), 28 varying] = [@0x7016D4D7:0, "\x0C        Help\x0A\x0ATopics are:\x0A\x0A"]
7016D59F WCMV emitted -	[@wp(ac3, 50), 231 varying] = [@0x7016D463:0, "    0 - Exit help     1 - Terrain\x0A    2 - Moving        3 - Commands\x0A    4 - Attack        5 - Spells\x0A    6 - Fire bow      7 - Seige\x0A    8 - Beings        9 - Structures\x0A   10 - Treasures    11 - Magic objects\x0A   12 - Food/water\x0A\x0A"]
7016D5B3 WCMV emitted -	[@wp(ac3, 34), 21 varying] = [@0x7016D457:0, "Topic number please: "]
7016D5D8 WCMV emitted -	[@wp(ac3, 34), 22 varying] = [@0x7016D44B:0, "\x0CTerrain symbols are:\x0A"]
7016D5EA WCMV emitted -	[@bp(ac3, 0x150), 164] = [@0x7016D3F9:0, "     - level ground    ff  - forest    ww  - shallow water\x0A WW  - deep water      mm  - foothill  MM  - mountain\x0A x   - road            ++  - ford      !!  - cliff\x0A"]
7016D5F0 WCMV emitted -	[@ac2, 150] = [@0x7016D3AD:0, " \x22\x22  - swamp           ()  - cave      .   - desert\x0A #   - catapult        %%  - boat      []  - transporter\x0A II  - magic barrier   ~~  - magic fog\x0A\x0A\x0A"]
7016D5FB WCMV emitted -	[@wp(ac3, 326), 314 varying] = [@bp(ac3, 336), 314]
7016D60F WCMV emitted -	[@wp(ac3, 50), 135 varying] = [@0x7016D369:0, "Special symbols are:\x0A\x0A    \x0E~~\x0F - shards of the crystal of Ablion\x0A    \x0E()\x0F - cave of the White Dragon\x0A    \x0Et\x0F  - the Dark Lord's staff\x0A\x0A"]
7016D626 WCMV emitted -	[@bp(ac3, 0x3C8), 217] = [@0x7016D2FB:0, "\x0C        Moving:\x0A\x0ATo move your character use either the cursor arrows\x0Aor the letters \x22N\x22, \x22S\x22, \x22E\x22 or \x22W\x22 to indicate the\x0Adirection to move. Home key will cause no movement.\x0A\x0A        Move Automatically:  [M command]\x0A\x0A"]
7016D62C WCMV emitted -	[@ac2, 248] = [@0x7016D27F:0, "To move automatically, input the direction and amount of moves\x0Adesired. This feature will move you double your input on roads,\x0Aand will end prematurely if you come in contact with an object\x0Aor being. ^C^A sequence will terminate a move automatic.\x0A\x0A"]
7016D637 WCMV emitted -	[@wp(ac3, 718), 465 varying] = [@bp(ac3, 968), 465]
7016D64E WCMV emitted -	[@bp(ac3, 0x150), 142] = [@0x7016D237:0, "\x0C        Commands:\x0A\x0AThe escape key will exit quest.\x0AThe erase page key will refresh the screen.\x0A A     -  attack\x0A R     -  release an object.\x0A"]
7016D654 WCMV emitted -	[@ac2, 137] = [@0x7016D1F1:0, " T     -  take an object from your castle.\x0A M     -  move automatic\x22.\x0A D     -  display spells status.\x0A G     -  allow use of a spyglass\x0A"]
7016D65D WCMV emitted -	[@bp(ac3, 0x3C8), 0x117] = [@bp(ac3, 0x150), 0x117]
7016D663 WCMV emitted -	[@ac2, 125] = [@0x7016D1B1:0, " L     -  list all players, being allies or castle info.\x0A C     -  cast non-attack spell.\x0A Q     -  quit seiging any castle.\x0A"]
7016D66C WCMV emitted -	[@bp(ac3, 0x770), 0x194] = [@bp(ac3, 0x3C8), 0x194]
7016D672 WCMV emitted -	[@ac2, 119] = [@0x7016D175:0, " X     -  allow castle rename within a castle.\x0A K     -  allow killing off of player.\x0A F     -  fire bow or cross bow.\x0A"]
7016D67B WCMV emitted -	[@bp(ac3, 0x97C), 0x20B] = [@bp(ac3, 0x770), 0x20B]
7016D681 WCMV emitted -	[@ac2, 134] = [@0x7016D131:0, " P     -  player alliances\x0A B     -  deal with backpack\x0A O     -  observe objects in your inventory\x0A ?     -  examine territory maps\x0A\x0A"]
7016D68C WCMV emitted -	[@wp(ac3, 1544), 657 varying] = [@bp(ac3, 2428), 657]
7016D6A3 WCMV emitted -	[@bp(ac3, 0x150), 139] = [@0x7016D0EB:0, "\x0C        Attacking: [A command]\x0A\x0AWhen attacking a being, you may cast, fight or ignore.\x0A\x0A\x14Cast\x15 enables you to utilizes one of your spells\x0A"]
7016D6A9 WCMV emitted -	[@ac2, 168] = [@0x7016D097:0, "available (see \x22Spells\x22). \x0A\x0A\x14Fight\x15 attacks the being with a proportionate strength hit.\x0A\x0A\x14Bargain\x15 allows you to attempt a deal.\x0A\x0A\x14Ignore\x15 allows you to exit Attack.\x0A\x0A"]
7016D6B4 WCMV emitted -	[@wp(ac3, 326), 307 varying] = [@bp(ac3, 336), 307]
7016D6CF WCMV emitted -	[@wp(ac3, 50), 165 varying] = [@0x7016D043:0, "\x0C        Spells:\x0A\x0AOne of the attack options is to cast a spell at the target.\x0AThe following is a list of your available spells and\x0Atheir effect on the opposition.\x0A\x0A\x0A"]
7016D713 WCMV emitted -	[@wp(ac3, 50), 121 varying] = [@0x7016D005:0, "\x0A\x14Lightning bolt\x15 -    A lightning bolt will descend from the\x0A                    heavens, striking a blow to the enemy.\x0A"]
7016D729 WCMV emitted -	[@wp(ac3, 50), 168 varying] = [@0x7016CFB1:0, "\x0A\x14Magic shield\x15 -      This transparent shield absorbs the blows\x0A                    from attacking beings, but at a cost of\x0A                    shattering the shield.\x0A"]
7016D73F WCMV emitted -	[@wp(ac3, 50), 120 varying] = [@0x7016CF75:0, "\x0A\x14Farenheit foiler\x15 -  A heat ray \x22foils\x22 the enemy, causing a\x0A                    lighter hit than the lightning bolt.\x0A"]
7016D755 WCMV emitted -	[@wp(ac3, 50), 118 varying] = [@0x7016CF39:0, "\x0A\x14Smoke screen\x15     -  Smoke billows forth, confusing your enemy\x0A                    and allowing you one extra move.\x0A"]
7016D76B WCMV emitted -	[@wp(ac3, 50), 167 varying] = [@0x7016CEE5:0, "\x0A\x14Obtain knowledge\x15 -  A strange sensation overcomes you. You are\x0A                    now able to determine strengths or levels\x0A                    of certain things.\x0A"]
7016D781 WCMV emitted -	[@wp(ac3, 50), 174 varying] = [@0x7016CE8D:0, "\x0A\x14Activate cloak\x15   -  If you have the magic green cloak, when\x0A                    this spell is in use, no new beings\x0A                    will be interested in killing you.\x0A"]
7016D797 WCMV emitted -	[@wp(ac3, 50), 176 varying] = [@0x7016CE35:0, "\x0A\x14Dumfound attacker\x15-  You can stop a being in pursuit by\x0A                    dumbfounding its mind. This will last only\x0A                    until the being regains it's wits.\x0A"]
7016D7AD WCMV emitted -	[@wp(ac3, 50), 167 varying] = [@0x7016CDE1:0, "\x0A\x14Healing aura\x15     -  The swirling colors of the aura of healing\x0A                    surrounds you, but do not move or,\x0A                    the spell will be broken.\x0A"]
7016D7C3 WCMV emitted -	[@wp(ac3, 50), 161 varying] = [@0x7016CD8F:0, "\x0A\x14Camouflage\x15       -  This spell will allow you to hide within\x0A                    a forest, foot hill, or mountain without\x0A                    being attacked.\x0A"]
7016D7D7 WCMV emitted -	[@bp(ac3, 100), 116] = [@0x7016CD55:0, "\x0A\x14Invisibility\x15     -  The fools the can no longer see you,\x0A                    but be wary of smarter opponents as\x0A"]
7016D7DD WCMV emitted -	[@ac2, 89] = [@0x7016CD27:0, "                    they can still see through your little\x0A                    disguise.\x0A"]
7016D7E8 WCMV emitted -	[@wp(ac3, 168), 205 varying] = [@bp(ac3, 100), 205]
7016D7FE WCMV emitted -	[@wp(ac3, 50), 160 varying] = [@0x7016CCD7:0, "\x0A\x14Wield Thors Hammer\x15- With a toss of THORs mighty hammer,\x0A                    a thundering exposition of power is\x0A                    unleashed at the victim.\x0A"]
7016D814 WCMV emitted -	[@wp(ac3, 50), 122 varying] = [@0x7016CC99:0, "\x0A\x14Teleport\x15         -  With the ancient teleport ring, you can\x0A                    teleport to any castle in your empire.\x0A"]
7016D828 WCMV emitted -	[@bp(ac3, 100), 123] = [@0x7016CC5B:0, "\x0A\x14Gaze into crystal\x15-  The crystal ball can be removed from its\x0A                    velvet bag to gaze upon the adventures\x0A"]
7016D82E WCMV emitted -	[@ac2, 103] = [@0x7016CC27:0, "                    of other players or see what forces\x0A                    surround a distant castle.\x0A"]
