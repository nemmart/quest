7016D951 WCMV emitted -	[@wp(ac3, 50), 106 varying] = [@0x7016C949:0, "\x0A\x14Clear Vision\x15     -  This spell can counteract the ill\x0A                    side effects of bad potions.\x0A"]
7016D967 WCMV emitted -	[@wp(ac3, 50), 170 varying] = [@0x7016C8F3:0, "\x0A\x14Panic\x15            -  When the situation looks hopeless\x0A                    use this spell to escape certain death.\x0A                    \x22When all else fails ... panic.\x22\x0A"]
7016D97D WCMV emitted -	[@wp(ac3, 50), 160 varying] = [@0x7016C8A3:0, "\x0A\x14Cause Fear\x15       -  A telepathic message is sent to\x0A                    your opponent causing fear. Step back\x0A                    and watch the chicken run.\x0A"]
7016D993 WCMV emitted -	[@wp(ac3, 50), 169 varying] = [@0x7016C84D:0, "\x0A\x14Conjour sun\x15      -  A cloud dispersing wind eminates\x0A                    from your spell causing all storms to\x0A                    vanish from the face of the earth.\x0A"]
7016D9A9 WCMV emitted -	[@wp(ac3, 50), 165 varying] = [@0x7016C7F9:0, "\x0A\x14Conjour storm\x15    -  A cloud gathering wind eminates\x0A                    from your spell causing a violent\x0A                    storm to be unleashed on the world.\x0A"]
7016D9BF WCMV emitted -	[@wp(ac3, 50), 145 varying] = [@0x7016C7AF:0, "\x0A\x14Dispatch familiar\x15-    A telepathic message is sent to\x0A                    your familiar with a direction in which\x0A                    to fly.\x0A"]
7016D9D5 WCMV emitted -	[@wp(ac3, 50), 165 varying] = [@0x7016C75B:0, "\x0A\x14Charm familiar\x15   -  An attempt is made to obtain a\x0A                    familiar, the magic flask must be\x0A                    used in conjunction with this spell.\x0A"]
7016D9EB WCMV emitted -	[@wp(ac3, 50), 112 varying] = [@0x7016C723:0, "\x0A\x14Recall familiar\x15  -  A telepathic message is sent to\x0A                    your familiar to send it back to you\x0A"]
7016DA01 WCMV emitted -	[@wp(ac3, 50), 118 varying] = [@0x7016C6E7:0, "\x0A\x14Familiar clairvoyance\x15  -   A telepathic image is sent back from\x0A                    your familiar of what it sees.\x0A"]
7016DA16 WCMV emitted -	[@wp(ac3, 50), 108 varying] = [@0x7016C6B1:0, "\x0A\x14Fireball\x15         -   A ball of fire races towards the enemy,\x0A                    causing burning damage.\x0A"]
7016DA2B WCMV emitted -	[@wp(ac3, 50), 123 varying] = [@0x7016C673:0, "\x0A\x14Create fog\x15       -   A cloud of fog envelopes an area around\x0A                    you and will last for quite some time.\x0A"]
7016DA40 WCMV emitted -	[@wp(ac3, 50), 115 varying] = [@0x7016C639:0, "\x0A\x14Polymorph\x15        -   Presto - chango, the being before you\x0A                    is no longer what it was before.\x0A"]
7016DA55 WCMV emitted -	[@wp(ac3, 50), 113 varying] = [@0x7016C5FF:0, "\x0A\x14Run like a horse\x15 -   For a limited duration, you will be\x0A                    able to take an extra move turn.\x0A"]
7016DA6A WCMV emitted -	[@wp(ac3, 50), 97 varying] = [@0x7016C5CD:0, "\x0A\x14Create food\x15      -   This spell creates one meal for instant\x0A                    consumption.\x0A"]
7016DA7F WCMV emitted -	[@wp(ac3, 50), 102 varying] = [@0x7016C599:0, "\x0A\x14Create water\x15     -   This spell will fill the water skin with\x0A                    drinkable water.\x0A"]
7016DACB WCMV emitted -	[@bp(ac3, 100), 86] = [@0x7016C56B:0, "\x0C        Firing: [F command]\x0A\x0AWhen firing at a being or catapult, you must first have\x0A"]
