7016BB0D WCMV emitted -	[@bp(ac3, 0xA64), 160] = [@0x7016AB95:0, "No wizard is complete without a faithful familiar.\x0AThe next quest involves obtaining a familiar. To charm\x0Aa familiar requires knowlege of a spell and a potion.\x0A"]
