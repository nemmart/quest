7016DAE0 WCMV emitted -	[@ac2, 125] = [@0x7016C4F5:0, "is issued, the cursor will be placed under a target in range.\x0AHit the \x22P\x22 or \x22A\x22 indicating the arrow type to fire. Any other"]
