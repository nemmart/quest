7016D914 WCMV emitted -	[@bp(ac3, 100), 167] = [@0x7016C9D7:0, "\x0A\x14Call Healer\x15      -  A telepathic message is sent to\x0A                    the healer CARRONE, and she may come\x0A                    to your aid if you have previously\x0A"]
