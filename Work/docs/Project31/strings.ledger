7016DDC9 WCMV emitted -	[@bp(ac3, 0x3C8), 184] = [@0x7016C005:0, "\x0A\x14Water\x15\x0A\x0A    You must drink water every 20 turns or you will begin\x0Ato weaken.  You can take a drink by walking into any drinkable\x0Awater source.  Water can be carried in a water skin.\x0A"]
7016DDCF WCMV emitted -	[@ac2, 237] = [@0x7016BF8D:0, "Empty skins are sold at stores for a nominal cost.  You can\x0Afill a water skin by moving through a drinkable source,\x0Aproviding that the skin is in your inventory (not backpack).\x0AYou must have the water skin in the inventory to drink from\x0A"]
